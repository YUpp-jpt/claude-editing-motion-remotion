{
  "name": "claude-editing-motion-remotion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A frame-driven Remotion recreation of a 30-second hand-drawn video editing animation.",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "check": "tsc --noEmit",
    "render": "remotion render src/index.tsx ClaudeEditingMotion renders/claude-editing-motion.mp4 --codec=h264 --pixel-format=yuv420p --crf=18 --concurrency=2",
    "still": "remotion still src/index.tsx ClaudeEditingMotion renders/poster.png --frame=870",
    "audio": "node tools/make-audio.mjs",
    "verify": "node tools/verify.mjs renders/claude-editing-motion.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "remotion": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "ffmpeg-static": "5.3.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {"node": ">=22"}
}
